# Compose overrides for the local groundkit stack.
#
# Copy to `.env` beside docker-compose.yml; compose loads it automatically.
# NAMES are documented here, values are never committed (repo policy, SPEC.md
# §7). Nothing in this file is a credential, and nothing in this stack needs
# one — that is the point of the local-first default.

# Host directory ingested and cited against, mounted read-only at /data/corpus.
# Relative paths resolve against this file's directory.
GROUNDKIT_CORPUS_DIR=../../docs

# Collection the one-shot ingest writes to, and the embedding model both ingest
# and serve use. These two must AGREE between an ingest and the serve that reads
# it: the collection manifest binds provider/model/dimensions and a mismatch is
# refused with IndexIdentityError, never re-embedded (ADR-0004).
GROUNDKIT_COLLECTION=default
GROUNDKIT_EMBED_MODEL=nomic-embed-text

# Host-side loopback ports. Changing these changes only where the HOST listens;
# the containers keep their own ports. Do not add a bind address here — the
# `127.0.0.1:` prefix in docker-compose.yml is the access control (ADR-0021
# decision 1), and making it configurable would make publishing the corpus a
# supported option.
GROUNDKIT_HOST_PORT=8765
JAEGER_UI_PORT=16686
