# Compose overrides for the local groundkit stack.
#
# Copy to `.env` beside docker-compose.yml; compose loads it automatically.
# NAMES are documented here, values are never committed (repo policy, SPEC.md
# §7). Nothing in this file is a credential, and nothing in this stack needs
# one — that is the point of the local-first default.

# Host directory ingested and cited against, mounted read-only at /data/corpus.
# Relative paths resolve against this file's directory.
GROUNDKIT_CORPUS_DIR=../../docs

# Collection the one-shot ingest writes to, and the embedding model both ingest
# and serve use. These two must AGREE between an ingest and the serve that reads
# it: the collection manifest binds provider/model/dimensions and a mismatch is
# refused with IndexIdentityError, never re-embedded (ADR-0004).
GROUNDKIT_COLLECTION=default
GROUNDKIT_EMBED_MODEL=nomic-embed-text

# Host-side loopback ports. Changing these changes only where the HOST listens;
# the containers keep their own ports. Do not add a bind address here — the
# `127.0.0.1:` prefix in docker-compose.yml is the access control (ADR-0021
# decision 1), and making it configurable would make publishing the corpus a
# supported option.
GROUNDKIT_HOST_PORT=8765
JAEGER_UI_PORT=16686

# --- OpenTelemetry (ADR-0022 decision 2) ----------------------------------
# Standard OTel environment variables, read directly by the SDK once the
# `otel` extra is installed — NOT by groundkit's config.py, which has no entry
# for any of these and never will: adding one would create a second,
# groundkit-specific vocabulary for a setting every collector, sidecar and
# operator tutorial already speaks in this form. The accepted consequence: a
# typo here produces the SDK's own error, not a groundkit ConfigurationError.
#
# Names only — no value is given here on purpose. Working defaults for this
# stack (pointed at its own otel-collector) are set directly in
# docker-compose.yml's `groundkit` and `ingest` service blocks; uncomment and
# set one here only to override them.
#OTEL_SERVICE_NAME=
#OTEL_EXPORTER_OTLP_ENDPOINT=
#OTEL_EXPORTER_OTLP_PROTOCOL=
#OTEL_TRACES_EXPORTER=
#OTEL_RESOURCE_ATTRIBUTES=

# Selects the JSON log formatter (ADR-0022 decision 4). Any value other than
# `json`, or unset, keeps human-readable logging — the default for a
# developer's terminal. The image already sets this to `json`; override here
# only to get human-readable logs back out of a container, e.g. for local
# debugging.
#GROUNDKIT_LOG_FORMAT=
