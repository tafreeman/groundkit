# groundkit runs fully local by default — no keys are required.
# Cloud providers are opt-in. Key NAMES are documented here; values are never committed.

# Local embedding provider (default)
GROUNDKIT_OLLAMA_BASE_URL=http://127.0.0.1:11434

# OpenAI-compatible cloud provider (opt-in; unset = provider unconfigured, fails closed)
GROUNDKIT_OPENAI_BASE_URL=
GROUNDKIT_OPENAI_API_KEY=

# Shared secret for mutating REST routes (Phase 4; unset = mutating routes disabled)
GROUNDKIT_APP_API_TOKEN=
